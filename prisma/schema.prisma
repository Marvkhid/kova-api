// ============================================================
// KOVA — Prisma Schema (Marketplace v3 + Seller Governance v4)
// v4 additions:
//   • SellerStatus lifecycle: PENDING → APPROVED / REJECTED,
//     plus SUSPENDED / BLOCKED (admin moderation states)
//   • Seller application timestamps + rejection reason
//   • Terms acceptance tracking (versioned)
//   • Product moderation: PENDING_REVIEW / REJECTED statuses
//     + admin moderationReason
// Run: npx prisma migrate deploy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // Clerk user ID ("local:<email>" for email+password accounts)
  email     String   @unique
  // bcrypt hash for email+password accounts (null = Clerk-only account)
  passwordHash String?
  // Set when the user confirms their email via the emailed link.
  emailVerifiedAt DateTime?
  name      String?
  avatarUrl String?
  bio       String?
  role      Role     @default(BUYER)
  // Buyer-facing phone (used for order shipping contact).
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products         Product[]
  orders           Order[]
  reviews          Review[]
  sellerReviewsReceived SellerReview[] @relation("SellerReviewsReceived")
  sellerReviewsGiven    SellerReview[] @relation("SellerReviewsGiven")
  sellerProfile    SellerProfile?
  wishlistItems    WishlistItem[]
  authTokens       AuthToken[]

  @@map("users")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// ── Auth tokens (email verification / password reset) ─────

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  // SHA-256 of the emailed token — the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ── Seller Profile ────────────────────────────────────────

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  storeSlug   String   @unique
  description String?
  // Nigerian state/city for the public store page — demo seeds use
  // fictional-but-plausible locations. No street addresses stored.
  location    String?
  logoUrl     String?
  bannerUrl   String?
  isVerified  Boolean  @default(false)
  payoutEmail String?

  // ── Seller governance (v4) ───────────────────────────────
  // Every seller application moves through review. Only APPROVED
  // sellers may publish products; SUSPENDED/BLOCKED lose that right.
  sellerStatus       SellerStatus @default(PENDING)
  // Contact + profile shown in the admin review screen
  phone              String?
  // Application lifecycle timestamps
  appliedAt          DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  suspendedAt        DateTime?
  // Sent to the seller when rejected (internal adminNote is NOT exposed)
  rejectionReason    String?
  adminNote          String?
  // Terms acceptance audit trail
  termsVersion       String?
  termsAcceptedAt    DateTime?
  // Category focus, free-text (e.g. "Handmade fashion & accessories")
  category           String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seller_profiles")
}

// Seller lifecycle. isVerified (above) mirrors APPROVED so existing
// UI keeps working; the enum is the source of truth.
enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
}

// ── Categories (database-driven) ──────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String? // short identifier used by the UI (e.g. "fashion")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// ── Products ──────────────────────────────────────────────

model Product {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique // generated once at creation — stable for QR codes
  description   String
  // Decimal(12,2): exact Naira + kobo, no float arithmetic for Naira.
  // Prisma returns Decimal; serialize with money()/toString().
  price         Decimal       @db.Decimal(12, 2)
  originalPrice Decimal?      @db.Decimal(12, 2)
  productType   ProductType   @default(PHYSICAL)
  status        ProductStatus @default(DRAFT)
  badge         ProductBadge?
  tags          String[]
  images        String[] // ordered image URLs — index 0 is the primary image
  inStock       Boolean       @default(true)
  rating        Float         @default(0) // aggregate from Review rows (rounded 0.1)
  reviewCount   Int           @default(0) // aggregate from Review rows
  buyCount      Int           @default(0) // aggregate from paid OrderItems
  viewCount     Int           @default(0)
  // Optional structured info shown on the product page
  condition     String? // e.g. "Brand new" | "Refurbished" | "Used — excellent"
  quantity      Int? // available units (physical stock)
  digitalInfo   String? // file type / access info for digital products
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Moderation (v4): why an admin rejected/removed this listing
  moderationReason String?
  // When a moderation decision was made
  moderatedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  orderItems    OrderItem[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([categoryId])
  @@map("products")
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNPUBLISHED
  REMOVED
}

enum ProductBadge {
  NEW
  HOT
  SALE
}

// ── Wishlist ──────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ── Orders ────────────────────────────────────────────────

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus  @default(UNPAID)
  paymentRef     String? // Paystack reference
  subtotal       Decimal       @db.Decimal(12, 2)
  shipping       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  // Demo seeds use Nigerian city/state only — no real private addresses.
  shippingAddress Json?
  items          OrderItem[]
  events         OrderEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

// Per-item fulfillment lifecycle — a mixed physical+digital order
// progresses independently per item type.
model OrderItem {
  id                String                 @id @default(cuid())
  orderId           String
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                @relation(fields: [productId], references: [id])
  quantity          Int
  // Price locked at purchase time (Decimal — matches product schema)
  price             Decimal                @db.Decimal(12, 2)
  fulfillmentStatus FulfillmentStatus      @default(PENDING)
  trackingNumber    String? // internal tracking code — never fabricated
  carrier           String? // logistics partner label where actually assigned
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum FulfillmentStatus {
  PENDING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// Append-only timeline. Every status change writes a row here.
// The buyer-facing tracking UI renders ONLY from these events —
// nothing is animated or inferred client-side.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String? // optional human note (e.g. "Handed to GIG Logistics")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ── Cart ──────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  sessionId String // guest cart session
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, productId])
  @@map("cart_items")
}

// ── Product Reviews ───────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  title     String?
  comment   String?
  // Set by the SERVER by checking real OrderItems — never trusted
  // from the client. true only when a PAID order links this user
  // to this product.
  verifiedPurchase Boolean @default(false)
  status    ReviewStatus @default(VISIBLE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, productId]) // one review per user per product
  @@index([productId, status, createdAt])
  @@map("reviews")
}

enum ReviewStatus {
  VISIBLE
  HIDDEN // admin-moderated (auditable via updatedAt)
}

// ── Seller Reviews (reputation) ───────────────────────────

model SellerReview {
  id          String   @id @default(cuid())
  // The store being rated
  sellerUserId String
  seller      User     @relation("SellerReviewsReceived", fields: [sellerUserId], references: [id], onDelete: Cascade)
  // The buyer who rated
  authorId    String
  author      User     @relation("SellerReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  rating      Int // 1-5 overall
  // Optional experience dimensions (1-5 each)
  communication Int?
  productAccuracy Int?
  packaging     Int?
  deliveryExperience Int?
  comment     String?
  status      ReviewStatus @default(VISIBLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sellerUserId, authorId]) // one seller review per buyer per store
  @@index([sellerUserId, status])
  @@map("seller_reviews")
}
